# Variables d'environnement de CS2 Nade Studio — chargées automatiquement au
# démarrage de app/main.py (voir _load_env_file()). Une variable déjà définie dans
# l'environnement (PowerShell $env:...) reste prioritaire sur cette valeur.

# Recharge la fenêtre principale/overlay dès qu'un fichier HTML/JS/CSS change sous
# app/ui/ — pratique en développement, sinon laisser à 0 (un rechargement réinitialise
# l'état JS de la fenêtre en cours de session, voir CLAUDE.md).
NADE_STUDIO_HOT_RELOAD=1
